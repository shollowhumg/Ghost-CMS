{
  "name": "@tryghost/prometheus-metrics",
  "version": "5.0.11",
  "author": "Ghost Foundation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryGhost/framework.git",
    "directory": "packages/prometheus-metrics"
  },
  "files": [
    "build"
  ],
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "typesVersions": {
    "*": {
      "server": [
        "build/server.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./server": {
      "types": "./build/server.d.ts",
      "default": "./build/server.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tryghost/debug": "^2.3.23",
    "@tryghost/logging": "^6.0.7",
    "prom-client": "^15.1.3",
    "stoppable": "^1.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/sinon": "22.0.2",
    "@types/stoppable": "1.1.3",
    "express": "5.3.0",
    "knex": "3.3.0",
    "nock": "15.0.6",
    "sinon": "22.1.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput --sourceMap",
    "build": "pnpm run build:ts",
    "build:ts": "tsc",
    "test:unit": "NODE_ENV=testing vitest run --coverage",
    "test": "pnpm run test:types && pnpm run test:unit",
    "test:types": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json ."
  }
}